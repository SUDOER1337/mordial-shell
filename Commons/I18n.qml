  function dateFormat() {
    return "dddd, MMMM d";
  }
  function hasTranslation(key) {
    return key in root.__en;
  }

  function tr(key, interpolations) {
    if (typeof interpolations === "undefined")
      interpolations = {};
    var value = root.__en[key];
    if (typeof value !== "string")
      return key;
    for (var k in interpolations) {
      value = value.replace(new RegExp("\\{" + k + "\\}", "g"), interpolations[k]);
    }
    return value;
  }

  function trp(key, count, interpolations) {
    if (typeof interpolations === "undefined")
      interpolations = {};
    var realKey = count === 1 ? key : key + "-plural";
    interpolations.count = count;
    return tr(realKey, interpolations);
  }

